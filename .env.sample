# Copy to .env. It is gitignored.
#
# Two things need configuring: where the models come from, and the credentials
# for whatever the packs fetch. Packs themselves name no models and hold no
# secrets, so the same pack runs against a local Ollama or a hosted API
# depending only on what is set here.
#
# `graphpack doctor` reports which path is active and whether it answers.


# ---------------------------------------------------------------------------
# Models — pick ONE of the two blocks below
# ---------------------------------------------------------------------------

# --- Local: Ollama ---------------------------------------------------------
# Free, nothing leaves the machine, and slow: extraction over a few thousand
# documents runs for hours on a laptop. Good for the development loop.
#
#   brew install ollama && brew services start ollama
#   ollama pull llama3.1:8b          # extraction, ~4.9 GB
#   ollama pull nomic-embed-text     # embeddings, ~275 MB
#
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=900
EMBEDDING_KIND=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --- Hosted API ------------------------------------------------------------
# Faster and better at schema-constrained extraction; costs money per run. Use
# for the measured runs, and say in the results which model produced them.
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_KIND=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
#
# Anthropic publishes no embedding model, so the embedding half comes from
# somewhere else. Two ways to pair it, and which you want depends on whether a
# corpus is already embedded.
#
# (a) Hosted model, embeddings stay local. Nothing is re-embedded and no new
#     Qdrant collection is needed — the vector dimension does not change.
#     This is the cheap path for adding a hosted extractor to existing work.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# EMBEDDING_KIND=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
#
# (b) Both halves hosted. The vector dimension changes, so this needs a new
#     collection: change stores.qdrant_collection in the pack, or run
#     `graphpack pack reset <pack>` first. Mixing dimensions fails at insert.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# EMBEDDING_KIND=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
#
# Google. The engine's own default model for this provider is gemini-2.5-flash,
# and llama-index's google_genai integration ships with it. Cheapest of the
# hosted options by input price, with one caveat worth knowing before you
# budget: Gemini 2.5 bills thinking tokens at the output rate, thinking is on
# by default, and the engine passes Gemini only model/api_key/temperature/
# timeout — so there is no way to set a thinking budget from here. Measure cost
# per chunk on a small sample rather than projecting from the sticker price.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_KIND=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
#
# Why a hosted provider is not only about speed: the engine forces bedrock,
# fireworks, groq, openai_like, openrouter and vllm onto DynamicLLMPathExtractor,
# and GraphPack adds ollama to that list because the schema extractor returns
# nothing on it. `anthropic` and `openai` are on neither list, so they drive
# SchemaLLMPathExtractor, which constrains extraction to the ontology's types.
# Measured on ollama: 17.8% of relations conform. See docs/RESULTS.md.
#
# Changing the embedding model changes the vector dimension, which means a new
# Qdrant collection: bump `stores.qdrant_collection` in the pack, or run
# `graphpack pack reset <pack>` first. Mixing dimensions in one collection fails
# at insert time with a message about the wrong vector size.


# ---------------------------------------------------------------------------
# Infrastructure — defaults match infra/compose.yaml
# ---------------------------------------------------------------------------

GRAPHPACK_NEO4J_URI=bolt://localhost:7687
GRAPHPACK_NEO4J_USER=neo4j
GRAPHPACK_NEO4J_PASSWORD=password
GRAPHPACK_QDRANT_HOST=localhost
GRAPHPACK_QDRANT_PORT=6333


# ---------------------------------------------------------------------------
# Pack sources
# ---------------------------------------------------------------------------

# The oss pack reads GitHub issues. Unauthenticated that is 60 requests an hour,
# which is not enough; with a token it is 5,000. Any token with public read
# access works — `gh auth token` prints one if the GitHub CLI is signed in.
GITHUB_TOKEN=
