# Copy to .env. It is gitignored.
#
# Two things need configuring: where the models come from, and the credentials
# for whatever the packs fetch. Packs themselves name no models and hold no
# secrets, so the same pack runs against a local Ollama or a hosted API
# depending only on what is set here.
#
# `graphpack doctor` reports which path is active and whether it answers.


# ---------------------------------------------------------------------------
# Models — pick ONE of the two blocks below
# ---------------------------------------------------------------------------

# --- Local: Ollama ---------------------------------------------------------
# Free, nothing leaves the machine, and slow: extraction over a few thousand
# documents runs for hours on a laptop. Good for the development loop.
#
#   brew install ollama && brew services start ollama
#   ollama pull llama3.1:8b          # extraction, ~4.9 GB
#   ollama pull nomic-embed-text     # embeddings, ~275 MB
#
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=900
EMBEDDING_KIND=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --- Hosted API ------------------------------------------------------------
# Faster and better at schema-constrained extraction; costs money per run. Use
# for the measured runs, and say in the results which model produced them.
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_KIND=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
#
# Anthropic has no embedding model, so pair it with another provider's:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# EMBEDDING_KIND=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
#
# Changing the embedding model changes the vector dimension, which means a new
# Qdrant collection: bump `stores.qdrant_collection` in the pack, or run
# `graphpack pack reset <pack>` first. Mixing dimensions in one collection fails
# at insert time with a message about the wrong vector size.


# ---------------------------------------------------------------------------
# Infrastructure — defaults match infra/compose.yaml
# ---------------------------------------------------------------------------

GRAPHPACK_NEO4J_URI=bolt://localhost:7687
GRAPHPACK_NEO4J_USER=neo4j
GRAPHPACK_NEO4J_PASSWORD=password
GRAPHPACK_QDRANT_HOST=localhost
GRAPHPACK_QDRANT_PORT=6333


# ---------------------------------------------------------------------------
# Pack sources
# ---------------------------------------------------------------------------

# The oss pack reads GitHub issues. Unauthenticated that is 60 requests an hour,
# which is not enough; with a token it is 5,000. Any token with public read
# access works — `gh auth token` prints one if the GitHub CLI is signed in.
GITHUB_TOKEN=
